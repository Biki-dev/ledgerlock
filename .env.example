# Copy to backend/.env for local development. Replace all secret values.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
LEDGERLOCK_DATABASE_URL=sqlite:///ledgerlock.db

# Three unique passwords, each at least 16 characters.
DEMO_REVIEWER_PASSWORD=replace-with-unique-reviewer-password
DEMO_APPROVER_PASSWORD=replace-with-unique-approver-password
DEMO_ADMIN_PASSWORD=replace-with-unique-admin-password

# Used by the local Kane browser runner.
KANE_BASE_URL=http://localhost:5173
KANE_APPROVER_EMAIL=approver@ledgerlock.demo
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
